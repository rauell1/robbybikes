{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "robbybikes",
  // OpenNext refreshes stale cached pages (revalidate) by calling this Worker
  // through this binding; without it the refresh is skipped and every
  // request renders the page again.
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "robbybikes" }],
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Run the Worker near its database and APIs rather than near each visitor.
  // Without this, every query from a page in Nairobi would cross to the
  // database region and back, which is slower than Vercel's single region.
  "placement": { "mode": "smart" },
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  // Runtime secrets (set with `npx wrangler secret put NAME` or in the dashboard):
  // DATABASE_URL, ADMIN_SESSION_SECRET, plus the storage credentials in .env.example.
  "keep_vars": true,
  // workers.dev stays on so old links and printed sheets keep working;
  // next.config.ts redirects it to the custom domain.
  "workers_dev": true,
  "routes": [{ "pattern": "robbybikes.rauell.systems", "custom_domain": true }],
  // Pooled connections to the Neon production database. Query caching is off,
  // so reads always see the latest writes. localConnectionString is only for
  // local tooling (wrangler dev, the OpenNext deploy step).
  "hyperdrive": [{
    "binding": "HYPERDRIVE",
    "id": "a61e7573bf074538beff098c7ce26202",
    "localConnectionString": "postgresql://postgres:postgres@localhost:5432/dev"
  }],
  "observability": { "enabled": true },
  // Shared sign-in and enquiry burst limits (lib/rate-limit.ts sharedRateLimit).
  "ratelimits": [
    { "name": "LOGIN_RATE_LIMITER", "namespace_id": "3001", "simple": { "limit": 5, "period": 60 } },
    { "name": "ENQUIRY_RATE_LIMITER", "namespace_id": "3002", "simple": { "limit": 3, "period": 60 } }
  ],
  // Page cache for open-next.config.ts (pages kept in R2; the bucket was
  // created ahead of the deploy).
  "r2_buckets": [
    { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "robbybikes-next-cache" }
  ],
  // Tag cache for revalidatePath/revalidateTag (open-next.config.ts).
  "kv_namespaces": [
    { "binding": "NEXT_TAG_CACHE_KV", "id": "964f960b37a94473b157b4f9251074e5" }
  ]
}
