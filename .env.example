# ---------------------------------------------------------------------------
# Robbybikes environment configuration
# Copy to .env.local for local development. Never commit real secrets.
# ---------------------------------------------------------------------------

# PostgreSQL connection string. Required.
# Production (Neon):
#   DATABASE_URL="postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/robbybikes?sslmode=require"
# Local preview: start `npm run demo:db`, then use the URL it prints:
#   DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/postgres"
DATABASE_URL=""

# Public site URL, used for canonical links, Open Graph, sitemap and WhatsApp
# listing links. Set to the production domain once it is live.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Secret used to sign administrator session cookies (min 32 characters).
# Generate with: openssl rand -base64 48
ADMIN_SESSION_SECRET=""

# WhatsApp number in international format, digits only (no +, no spaces).
# Confirm with the dealership which of the two phone numbers has WhatsApp.
WHATSAPP_NUMBER="254768462250"

# Optional: official TikTok profile URL. Leave blank until verified.
SOCIAL_TIKTOK_URL=""

# Optional: Vercel Blob token for image uploads in production.
# Without it, uploads are stored on the local filesystem (development only).
BLOB_READ_WRITE_TOKEN=""

# Optional: Google Analytics 4 measurement ID. Analytics is off when blank.
NEXT_PUBLIC_GA_ID=""

# Optional: comma separated extra hostnames allowed to post server actions
# through a reverse proxy, e.g. "*.e2b.app". Usually not needed.
SERVER_ACTION_ALLOWED_ORIGINS=""

# Local preview only: where `npm run demo:db` stores its embedded PostgreSQL
# data, and the port it listens on.
DEMO_DB_DATA_DIR=".data/pg"
DEMO_DB_PORT="5433"

# Local development only: where uploaded images are written when Blob is off.
UPLOAD_DIR=".data/uploads"

# Optional demo banner/credentials on the admin login screen. Leave unset for
# a real deployment.
DEMO_MODE=""
